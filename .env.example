DEEPSEEK_API_KEY=sk-请替换为你的Key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
JWT_SECRET=请替换为随机字符串
PORT=8000
AMAP_API_KEY=请粘贴你的高德Web服务Key（可留空，留空则不启用高德地图MCP）

# ---- RAG 混合检索（BM25 + 向量）----
# 知识库文件目录：启动时自动扫描，支持 .md/.txt/.docx/.pdf/.xlsx/.xlsm/.csv
# 不设置（或注释掉）则默认用 seed/kb_files
# KB_FILES_DIR=/app/seed/kb_files
# 向量后端：auto（有 numpy 用 LSA，否则哈希向量）/ lsa / hashing
# EMBEDDING_BACKEND=auto
# LSA 向量维度
# EMBEDDING_DIM=128
# 融合权重（两者相加建议为 1）
# HYBRID_BM25_WEIGHT=0.55
# HYBRID_VECTOR_WEIGHT=0.45
# 每路召回候选条数
# RETRIEVE_CANDIDATES=20

# ---- 数据库位置（Docker 部署时配合 -v 挂载做数据持久化）----
# DB_PATH=/app/data/campus.db
